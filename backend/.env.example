# CyberWatch IDS - Environment Variables
# Copy this file to .env and adjust values

# Server
PORT=8421
RUST_LOG=info,cyberwatch=debug

# Database
DATABASE_PATH=../data/cve-database.db

# Auth
JWT_SECRET=cyberwatch-ids-rust-secret-key-change-in-production

# CORS — comma-separated list of allowed origins (e.g. https://app.example,https://dash.example)
# Leave EMPTY for same-origin only (secure default; recommended for the bundled SPA)
CORS_ALLOWED_ORIGINS=

# Security headers
# Set to true ONLY when served behind a TLS-terminating proxy (nginx/Caddy/LB)
HSTS_ENABLED=false

# Rate limiting (per IP)
# 1 token replenished every RATE_LIMIT_PER_SECOND seconds; burst up to RATE_LIMIT_BURST
RATE_LIMIT_PER_SECOND=2
RATE_LIMIT_BURST=30

# Set to true ONLY behind a trusted reverse proxy that OVERWRITES
# X-Forwarded-For / X-Real-IP. Otherwise clients can spoof those headers
# to bypass rate limits. Leave false for direct exposure / local dev.
RATE_LIMIT_TRUST_PROXY=false

# Account lockout (per ACCOUNT; complements the per-IP rate limit above)
# After N consecutive failed logins the account is locked for M seconds.
# Values are clamped: attempts 3-20, lockout 60-86400 seconds.
# A successful login resets the counter; an expired lock starts a fresh window.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Email notifications (Task #27) — DISABLED by default.
# Enable only after configuring a real SMTP account; never commit credentials.
# SMTP_TLS_MODE: starttls (587, default) | implicit (465) | none (local dev only)
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=CyberWatch IDS <no-reply@example.com>

# Fallback recipients when an org has no active admin email.
# Alert emails also require the org's `emailAlerts` setting to be enabled
# (toggle in Admin > Organization).
ALERT_EMAIL_TO=
ALERT_EMAIL_MIN_SEVERITY=CRITICAL
